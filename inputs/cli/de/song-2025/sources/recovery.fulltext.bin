    <meta name="Specialties" content="Cardiology|Surgery">
<meta name="isFree" content="y">
<meta name="articleType" content="Original Article">
<meta name="shortAbstract" content="
Early Surgery for Asymptomatic Aortic Stenosis
Asymptomatic patients with very severe aortic stenosis were randomly assigned to either early valve-replacement surgery or conservative care. At a median of 6 years of follow-up, the composite of operative mortality or death from cardiovascular causes occurred less frequently in the early-surgery group.
">
<meta name="viewType" content="Full">
<meta name="articleCategory" content="Research">
<meta name="isOnlineFirst" content="n">
<meta name="isCurrentIssue" content="n">
<meta name="age" content="2Years-1990"><!-- /Printing Meta Tags -->

    
