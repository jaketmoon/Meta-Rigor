cs-icon--downloads"><path d="M10 5.5H7v-4H3v4H0l5 5zm-10 6v1h10v-1z"></path></svg><span class="total-text" data-count="68807">68,807</span></span><span class="toolbar-metric__total toolbar-metric__total--citations "><svg aria-hidden="true" viewBox="0 0 14 14" class="metrics-icon metrics-icon--citations"><path d="M2.3 11h2l2-3V3h-5v5h3zm6.4 0h2l2-3V3h-5v5h3z"></path></svg><span class="total-text" data-count="276">276</span></span></a><div class="metrics-menu__dropdown-container toolbar-metric__menu" data-metrics-target-of="toolbar-metric--menu" aria-hidden="true" tabindex="-1"><div class="metrics-rlist metrics-menu__dropdown"><h3 class="toolbar-metric__menu-title">Metrics</h3><section class="toolbar-metric__menu-section "><svg aria-hidden="true" viewBox="-2 0 14 14" class="metrics-icon metrics-icon--downloads"><path d="M10 5.5H7v-4H3v4H0l5 5zm-10 6v1h10v-1z"></path></svg><div class="toolbar-metric__menu-section-counts"><h4 class="menu-title menu-title--downloads "><span class="menu-title-text">Total Downloads</span><span class="menu-total-value">68,807</span></h4><ul class="menu-list metrics-rlist"><li><span class="menu-item-text">Last 12 Months</span><span class="menu-item-value">8,845</span></li></ul></div></section><section class="toolbar-metric__menu-section "><svg aria-hidden="true" viewBox="0 0 14 14" class="metrics-icon metrics-icon--citations"><path d="M2.3 11h2l2-3V3h-5v5h3zm6.4 0h2l2-3V3h-5v5h3z"></path></svg><div class="toolbar-metric__menu-section-counts"><h4 class="menu-title menu-title--citations "><span class="menu-title-text">Total Citations</span><span class="menu-total-value">276</span></h4><ul class="menu-list metrics-rlist"><li><span class="menu-item-text">Last 12 Months</span><span class="menu-item-value">90</span></li></ul></div></section></div><a class="toolbar-metric__metrics-link" href="https://www.ahajournals.org/doi/full/10.1161/CIRCULATIONAHA.121.057639?doi=10.1161/CIRCULATIONAHA.121.057639#tab-metrics-inner" title="Go to metrics page" tab