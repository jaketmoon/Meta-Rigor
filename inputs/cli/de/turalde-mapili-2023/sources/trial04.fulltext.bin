<more-like-this class="onepub-widget" collections="catalyst-article, clinician-article, evidence-article, nejm-ai-article, nejm-article, voices-article" dataid="onepub-more-like-this" headertitle="More Like This" maxitems="5"><!-- --><div class="more-like-this onepub-more-like-this_"><!--?lit$012487953$--><onepub-fonts><template shadowrootmode="open"><!-- --><slot></slot></template><wc-fetch><template shadowrootmode="open"><!-- --><slot><!--?lit$012487953$--></slot></template></wc-fetch><!--?lit$012487953$--><div class="mlt-wrapper"><div class="mlt-header-container"><div class="mlt-header-content-left"><div class="mlt-header-title-container"><span class="mlt-header-title">More Like This</span></div><!--?lit$012487953$--></div></div><div class="mlt-body"><!--?lit$012487953$--><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm-evidence" data-location="recirc_Semantic" href="https://evidence.nejm.org/browse/nejm-article-type/editorial?query=recirc_Semantic" target="_self"><!--?lit$012487953$-->Editorial</a> <span class="mlt-article-site-label"><!--?lit$012487953$-->NEJM Evidence</span> <span class="mlt-article-pubdate"><!--?lit$012487953$-->2月 25日, 2025年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://evidence.nejm.org/doi/full/10.1056/EVIDe2400440?query=recirc_Semantic" target="_self">Nirsevimab for Respiratory Syncytial Virus Prophylaxis in Newborns and Infants</a></div><div class="mlt-article-authors"><!--?lit$012487953$-->B. Resch</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm-clinician" data-location="recirc_Semantic" href="https://clinician.nejm.org/browse/journal-watch" target="_self"><!--?lit$012487953$-->Journal Watch</a> <span class="mlt-article-site-label"><!--?lit$012487953$-->NEJM Clinician</span> <span class="mlt-article-pubdate"><!--?lit$012487953$-->3月 8日, 2022年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://clinician.nejm.org/10.1056/nejm-jw.NA54664?query=recirc_Semantic" target="_self">Nirsevimab for Respiratory Syncytial Virus Prophylaxis in Healthy Infants</a></div><div class="mlt-article-authors"><!--?lit$012487953$-->M.C. O'Dwyer</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm" data-location="recirc_Semantic" href="https://www.nejm.org/browse/nejm-article-type/original-article" target="_self"><!--?lit$012487953$-->Original Article</a> <span class="mlt-article-site-label"><!--?lit$012487953$-->NEJM</span> <span class="mlt-article-pubdate"><!--?lit$012487953$-->9月 26日, 2024年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://www.nejm.org/doi/full/10.1056/NEJMoa2313551?query=recirc_Semantic" target="_self">Ziresovir in Hospitalized Infants with Respiratory Syncytial Virus Infection</a></div><div class="mlt-article-authors"><!--?lit$012487953$-->S. Zhao and Others</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm-clinician" data-location="recirc_Semantic" href="https://clinician.nejm.org/browse/journal-watch" target="_self"><!--?lit$012487953$-->Journal Watch</a> <span class="mlt-article-site-label"><!--?lit$012487953$-->NEJM Clinician</span> <span class="mlt-article-pubdate"><!--?lit$012487953$-->8月 6日, 2020年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://clinician.nejm.org/10.1056/nejm-jw.NA52060?query=recirc_Semantic" target="_self">Trial of Nirsevimab for Respiratory Syncytial Virus Prophylaxis in Preterm Infants</a></div><div class="mlt-article-authors"><!--?lit$012487953$-->R.H. Steinhorn</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm" data-location="recirc_Semantic" href="https://www.nejm.org/browse/nejm-article-type/original-article" target="_self"><!--?lit$012487953$-->Original Article</a> <span class="mlt-article-site-label"><!--?lit$012487953$-->NEJM</span> <span class="mlt-article-pubdate"><!--?lit$012487953$-->12月 28日, 2023年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://www.nejm.org/doi/full/10.1056/NEJMoa2309189?query=recirc_Semantic" target="_self">Nirsevimab for Prevention of Hospitalizations Due to RSV in Infants</a></div><div class="mlt-article-authors"><!--?lit$012487953$-->S.B. Drysdale and Others</div></div><!-- --></div><div class="mlt-footer"></div></div></onepub-fonts><style>:host{display:block}@keyframes fadeIn{0%{opacity:0}100%{opacity:1}}.more-like-this{max-width:25rem}.more-like-this *{font-variant-numeric:lining-nums}.mlt-wrapper{animation:fadeIn 1s}.mlt-header-container{border-bottom:#4d4d4d solid .0625rem;border-top:#4d4d4d solid .125rem}.mlt-header-title{color:#1a1a1a;display:block;font-family:var(--sans-serif);font-size:1rem;font-weight:700;letter-spacing:.02rem;line-height:1.5rem;padding-bottom:.94rem;padding-top:.94rem;text-transform:uppercase}.mlt-header-description{color:#333;display:block;font-family:ff-scala-sans-pro;font-size:.75rem;letter-spacing:.05rem;margin-top:-.5rem;padding-bottom:1rem;text-transform:uppercase}.mlt-article-container{border-bottom:#e5e5e5 solid .0625rem;margin-top:1.38rem}.mlt-article-container-header{font-family:var(--sans-serif);font-size:.6875rem;letter-spacing:.04em;line-height:1.125rem;margin:0 0 1rem;text-transform:uppercase}.mlt-article-type{font-weight:700;line-height:1.25rem;letter-spacing:.04rem;text-decoration:none}.mlt-article-type:hover{text-decoration:underline}.nejm{color:#f30}.nejm-ai{color:#006197}.nejm-catalyst{color:#5708a6}.nejm-clinician{color:#114980}.nejm-evidence{color:#69a323}.nejm-voices{color:#e02d00}.mlt-article-site-label::after,.mlt-article-type::after{bor