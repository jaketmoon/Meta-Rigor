<more-like-this class="onepub-widget" collections="catalyst-article, clinician-article, evidence-article, nejm-ai-article, nejm-article, voices-article" dataid="onepub-more-like-this" headertitle="More Like This" maxitems="5"><!-- --><div class="more-like-this onepub-more-like-this_"><!--?lit$755776665$--><onepub-fonts><template shadowrootmode="open"><!-- --><slot></slot></template><wc-fetch><template shadowrootmode="open"><!-- --><slot><!--?lit$755776665$--></slot></template></wc-fetch><!--?lit$755776665$--><div class="mlt-wrapper"><div class="mlt-header-container"><div class="mlt-header-content-left"><div class="mlt-header-title-container"><span class="mlt-header-title">More Like This</span></div><!--?lit$755776665$--></div></div><div class="mlt-body"><!--?lit$755776665$--><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm-evidence" data-location="recirc_Semantic" href="https://evidence.nejm.org/browse/nejm-article-type/editorial?query=recirc_Semantic" target="_self"><!--?lit$755776665$-->Editorial</a> <span class="mlt-article-site-label"><!--?lit$755776665$-->NEJM Evidence</span> <span class="mlt-article-pubdate"><!--?lit$755776665$-->2月 25日, 2025年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://evidence.nejm.org/doi/full/10.1056/EVIDe2400440?query=recirc_Semantic" target="_self">Nirsevimab for Respiratory Syncytial Virus Prophylaxis in Newborns and Infants</a></div><div class="mlt-article-authors"><!--?lit$755776665$-->B. Resch</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm-clinician" data-location="recirc_Semantic" href="https://clinician.nejm.org/browse/journal-watch" target="_self"><!--?lit$755776665$-->Journal Watch</a> <span class="mlt-article-site-label"><!--?lit$755776665$-->NEJM Clinician</span> <span class="mlt-article-pubdate"><!--?lit$755776665$-->3月 8日, 2022年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://clinician.nejm.org/10.1056/nejm-jw.NA54664?query=recirc_Semantic" target="_self">Nirsevimab for Respiratory Syncytial Virus Prophylaxis in Healthy Infants</a></div><div class="mlt-article-authors"><!--?lit$755776665$-->M.C. O'Dwyer</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm" data-location="recirc_Semantic" href="https://www.nejm.org/browse/nejm-article-type/original-article" target="_self"><!--?lit$755776665$-->Original Article</a> <span class="mlt-article-site-label"><!--?lit$755776665$-->NEJM</span> <span class="mlt-article-pubdate"><!--?lit$755776665$-->9月 26日, 2024年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://www.nejm.org/doi/full/10.1056/NEJMoa2313551?query=recirc_Semantic" target="_self">Ziresovir in Hospitalized Infants with Respiratory Syncytial Virus Infection</a></div><div class="mlt-article-authors"><!--?lit$755776665$-->S. Zhao and Others</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article-type nejm-clinician" data-location="recirc_Semantic" href="https://clinician.nejm.org/browse/journal-watch" target="_self"><!--?lit$755776665$-->Journal Watch</a> <span class="mlt-article-site-label"><!--?lit$755776665$-->NEJM Clinician</span> <span class="mlt-article-pubdate"><!--?lit$755776665$-->8月 6日, 2020年</span></div><div class="mlt-article-title"><a data-location="recirc_Semantic" href="https://clinician.nejm.org/10.1056/nejm-jw.NA52060?query=recirc_Semantic" target="_self">Trial of Nirsevimab for Respiratory Syncytial Virus Prophylaxis in Preterm Infants</a></div><div class="mlt-article-authors"><!--?lit$755776665$-->R.H. Steinhorn</div></div><!-- --><!-- --><div class="mlt-article-container"><div class="mlt-article-container-header"><a class="mlt-article