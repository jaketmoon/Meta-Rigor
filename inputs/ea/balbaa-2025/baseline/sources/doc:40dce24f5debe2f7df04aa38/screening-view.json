evidence to suggest that a shortened fluid fast results in an increased risk of aspiration, regurgitation or related morbidity compared with the standard 'nil by mouth from midnight' fasting policy. However, there is no available data regarding the safety and efficacy of fasting approach in patients undergoing cardiac implantable electronic device (CIED) procedures. The aim of this study is to demonstrate that a non-fasting protocol is non-inferior in regard to safety to a fasting protocol (current practice) in patients undergoing cardiac device implantation procedures\n\n"},{"end_offset":1520,"heading":null,"page":2,"segment_id":"S000047","start_offset":1514,"table_hint":null,"text":"Hide\n\n"},{"end_offset":1532,"heading":null,"page":2,"segment_id":"S000048","start_offset":1520,"table_hint":null,"text":"Enrollment\n\n"},{"end_offset":1546,"heading":null,"page":2,"segment_id":"S000049","start_offset":1532,"table_hint":null,"text":"201 patients\n\n"},{"end_offset":1551,"heading":null,"page":2,"segment_id":"S000050","start_offset":1546,"table_hint":null,"text":"Sex\n\n"},{"end_offset":1556,"heading":null,"page":2,"segment_id":"S000051","start_offset":1551,"table_hint":null,"text":"All\n\n"},{"end_offset":1562,"heading":null,"page":2,"segment_id":"S000052","start_offset":1556,"table_hint":null,"text":"Ages\n\n"},{"end_offset":1577,"heading":null,"page":2,"segment_id":"S000053","start_offset":1562,"table_hint":null,"text":"18+ years old\n\n"},{"end_offset":1589,"heading":null,"page":2,"segment_id":"S000054","start_offset":1577,"table_hint":null,"text":"Volunteers\n\n"},{"end_offset":1612,"heading":null,"page":2,"segment_id":"S000055","start_offset":1589,"table_hint":null,"text":"No Healthy Volunteers\n\n"},{"end_offset":1632,"heading":null,"page":2,"segment_id":"S000056","start_offset":1612,"table_hint":null,"text":"Inclusion criteria\n\n"},{"end_offset":1753,"heading":null,"page":2,"segment_id":"S000057","start_offset":1632,"table_hint":null,"text":"All patients >18 years undergoing elective implantation or generator exchange of cardiac implantable electronic devices\n\n"},{"end_offset":1773,"heading":null,"page":2,"segment_id":"S000058","start_offset":1753,"table_hint":null,"text":"Exclusion criteria\n\n"},{"end_offset":1875,"heading":null,"page":2,"segment_id":"S000059","start_offset":1773,"table_hint":null,"text":"Patients presenting with an acute unstable condition (bradycardia < 30/min or temporary pacing wire)\n\n"},{"end_offset":1893,"heading":null,"page":3,"segment_id":"S000060","start_offset":1875,"table_hint":null,"text":"[DOCLING_PAGE 3]\n\n"},{"end_offset":1931,"heading":null,"page":3,"segment_id":"S000061","start_offset":1893,"table_hint":null,"text":"Patients scheduled for deep sedation\n\n"},{"end_offset":2013,"heading":null,"page":3,"segment_id":"S000062","start_offset":1931,"table_hint":null,"text":"Patients with increased intra-abdominal pressure (severe intra-abdominal tumors,\n\n"},{"end_offset":2066,"heading":null,"page":3,"segment_id":"S000063","start_offset":2013,"table_hint":null,"text":"severe ascites, very severe obesity: BMI>40 kg/m2).\n\n"},{"end_offset":2080,"heading":null,"page":3,"segment_id":"S000064","start_offset":2066,"table_hint":null,"text":"Trial design\n\n"},{"end_offset":2097,"heading":null,"page":3,"segment_id":"S000065","start_offset":2080,"table_hint":null,"text":"Primary purpose\n\n"},{"end_offset":2114,"heading":null,"page":3,"segment_id":"S000066","start_offset":2097,"table_hint":null,"text":"Supportive Care\n\n"},{"end_offset":2126,"heading":null,"page":3,"segment_id":"S000067","start_offset":2114,"table_hint":null,"text":"Allocation\n\n"},{"end_offset":2138,"heading":null,"page":3,"segment_id":"S000068","start_offset":2126,"table_hint":null,"text":"Randomized\n\n"},{"end_offset":2160,"heading":null,"page":3,"segment_id":"S000069","start_offset":2138,"table_hint":null,"text":"Interventional model\n\n"},{"end_offset":2181,"heading":null,"page":3,"segment_id":"S000070","start_offset":