ffset":929,"heading":null,"page":2,"segment_id":"S000043","start_offset":906,"table_hint":null,"text":"Collaborating Sponsor\n\n"},{"end_offset":942,"heading":null,"page":2,"segment_id":"S000044","start_offset":929,"table_hint":null,"text":"AstraZeneca\n\n"},{"end_offset":975,"heading":null,"page":2,"segment_id":"S000045","start_offset":942,"table_hint":null,"text":"Details and patient eligibility\n\n"},{"end_offset":982,"heading":null,"page":2,"segment_id":"S000046","start_offset":975,"table_hint":null,"text":"About\n\n"},{"end_offset":1062,"heading":null,"page":2,"segment_id":"S000047","start_offset":982,"table_hint":null,"text":"The purpose of this study was to determine the efficacy and safety of a single\n\n"},{"end_offset":1153,"heading":null,"page":2,"segment_id":"S000048","start_offset":1062,"table_hint":null,"text":"intramuscular (IM) dose of nirsevimab, compared to no intervention, for the prevention of\n\n"},{"end_offset":1243,"heading":null,"page":2,"segment_id":"S000049","start_offset":1153,"table_hint":null,"text":"hospitalizations due to lower respiratory tract infection (LRTI) caused by confirmed RSV\n\n"},{"end_offset":1339,"heading":null,"page":2,"segment_id":"S000050","start_offset":1243,"table_hint":null,"text":"infection (henceforth referred to as RSV LRTI hospitalizations) in all infants under 12 months\n\n"},{"end_offset":1393,"heading":null,"page":2,"segment_id":"S000051","start_offset":1339,"table_hint":null,"text":"of age who were not eligible to receive palivizumab.\n\n"},{"end_offset":1404,"heading":null,"page":2,"segment_id":"S000052","start_offset":1393,"table_hint":null,"text":"Read more\n\n"},{"end_offset":1497,"heading":null,"page":2,"segment_id":"S000053","start_offset":1404,"table_hint":null,"text":"The visit frequency was 1 in-person dosing/randomization visit, with monthly safety follow-\n\n"},{"end_offset":1509,"heading":null,"page":2,"segment_id":"S000054","start_offset":1497,"table_hint":null,"text":"Enrollment\n\n"},{"end_offset":1525,"heading":null,"page":2,"segment_id":"S000055","start_offset":1509,"table_hint":null,"text":"8,057 patients\n\n"},{"end_offset":1530,"heading":null,"page":2,"segment_id":"S000056","start_offset":1525,"table_hint":null,"text":"Sex\n\n"},{"end_offset":1535,"heading":null,"page":2,"segment_id":"S000057","start_offset":1530,"table_hint":null,"text":"All\n\n"},{"end_offset":1541,"heading":null,"page":2,"segment_id":"S000058","start_offset":1535,"table_hint":null,"text":"Ages\n\n"},{"end_offset":1562,"heading":null,"page":2,"segment_id":"S000059","start_offset":1541,"table_hint":null,"text":"Under 12 months old\n\n"},{"end_offset":1574,"heading":null,"page":2,"segment_id":"S000060","start_offset":1562,"table_hint":null,"text":"Volunteers\n\n"},{"end_offset":1602,"heading":null,"page":2,"segment_id":"S000061","start_offset":1574,"table_hint":null,"text":"Accepts Healthy Volunteers\n\n"},{"end_offset":1622,"heading":null,"page":2,"segment_id":"S000062","start_offset":1602,"table_hint":null,"text":"Inclusion criteria\n\n"},{"end_offset":1776,"heading":null,"page":2,"segment_id":"S000063","start_offset":1622,"table_hint":null,"text":"Born at ≥ 29 weeks gestational age and aged 0 to 12 months (calendar age), who entered their first RSV season on the day of inclusion in the study (D01)\n\n"},{"end_offset":1918,"heading":null,"page":2,"segment_id":"S000064","start_offset":1776,"table_hint":null,"text":"Informed consent form was signed and dated by the parent(s) or other LAR(s) (and by an independent witness if required by local regulations)\n\n"},{"end_offset":2026,"heading":null,"page":2,"segment_id":"S000065","start_offset":1918,"table_hint":null,"text":"Participant and parent/LAR were able to attend the scheduled visit and to comply with all study procedures\n\n"},{"end_offset":2046,"heading":null,"page":2,"segment_id":"S000066","start_offset":2026,"table_hint":null,"text":"Exclusion criteria\n\n"},{"end_offset":2134,"heading":null,"page":2,"segment_id":"S000067","start_offset":2046,"table_hint":null,"text":"Participants were not eligible for the study if any of the following criteria are met:\n\n"},{"end_offset":2282,"heading":null,"page":2,"segment_id":"S000068","start_offset":2134,"table_hint":null,"text":"Known or suspected congenital or acquired immunodeficiency; or receipt of immunosuppressive therapy, such as anti-cancer chemotherapy or radiation\n\n"},{"end_offset":2302,"heading":null,"page":2,"segment_id":"S000069","start_offset":2282,"table_hint":null,"text":"View trial history\n\n"},{"end_offset":2469,"heading":null,"page":2,"segment_id":"S000070","start_offset":2302,"table_hint":null,"text":"View therapy, within the preceding 6 months; or long-term systemic corticosteroid therapy (prednisone or equivalent for more than 2 consecutive weeks within the past\n\n"},{"end_offset":2475,"heading":null,"page":2,"segment_id":"S000071","start_offset":2469,"table_hint":null,"text":"Menu\n\n"},{"end_offset":2493,"heading":null,"page":3,"segment_id":"S000072","start_offset":2475,"table_hint":null,"text":"[DOCLING_PAGE 3]\n\n"},{"end_offset":2504,"heading":null,"page":3,"segment_id":"S000073","start_offset":2493,"table_hint":null,"text":"3 months)\n\n"},{"end_offset":2572,"heading":null,"page":3,"segment_id":"S000074","start_offset":2504,"table_hint":null,"text":"Active confirmed RSV infection at the time of dosing/randomization\n\n"},{"end_offset":2621,"heading":null,"page":3,"segment_id":"S000075","start_offset":2572,"table_hint":null,"text":"Active LRTI at the time of dosing/randomization\n\n"},{"end_offset":2839,"heading":null,"page":3,"segment_id":"S000076","start_offset":2621,"table_hint":null,"text":"Known systemic hypersensitivity to any of the study intervention components, or history of a life-threatening reaction to the study intervention used in the study or to a product containing any of the same substances\n\n"},{"end_offset":2978,"heading":null,"page":3,"segment_id":"S000077","start_offset":2839,"table_hint":null,"text":"Laboratory confirmed thrombocytopenia, or known thrombocytopenia, as reported by the parent/LAR, contraindicating intramuscular injection\n\n"},{"end_offset":3104,"heading":null,"page":3,"segment_id":"S000078","start_offset":2978,"table_hint":null,"text":"Bleeding disorder, or receipt of anticoagulants in the 3 weeks preceding inclusion, contraindicating intramuscular injection\n\n"},{"end_offset":3233,"heading":null,"page":3,"segment_id":"S000079","start_offset":3104,"table_hint":null,"text":"Any condition that, in the opinion of the investigator, is at a stage where it might interfere with study conduct or completion\n\n"},{"end_offset":3418,"heading":null,"page":3,"segment_id":"S000080","start_offset":3233,"table_hint":null,"text":"Moderate or severe acute illness/infection (according to investigator judgment) or febrile illness (temperature ≥ 38.0°C [ ≥ 100.4°F]) on the day of study intervention administration.\n\n"},{"end_offset":3542,"heading":null,"page":3,"segment_id":"S000081","start_offset":3418,"table_hint":null,"text":"A prospective participant was not included in the study until the condition has resolved or the febrile event has subsided\n\n"},{"end_offset":3657,"heading":null,"page":3,"segment_id":"S000082","start_offset":3542,"table_hint":null,"text":"Mother of the infant participant was administered an RSV vaccine during her pregnancy with the infant participant\n\n"},{"end_offset":3719,"heading":null,"page":3,"segment_id":"S000083","start_offset":3657,"table_hint":null,"text":"Receipt of any monoclonal antibody by the infant participant\n\n"},{"end_offset":3828,"heading":null,"page":3,"segment_id":"S000084","start_offset":3719,"table_hint":null,"text":"Receipt of immune globulins, blood or blood-derived products in the past 3 months by the infant participant\n\n"},{"end_offset":4026,"heading":null,"page":3,"segment_id":"S000085","start_offset":3828,"table_hint":null,"text":"Participation at the time of study enrollment or planned participation during the present study period in another clinical study investigating a vaccine, drug, medical device, or medical procedure\n\n"},{"end_offset":4106,"heading":null,"page":3,"segment_id":"S000086","start_offset":4026,"table_hint":null,"text":"Eligible to receive palivizumab at time of inclusion (as per local guidelines)\n\n"},{"end_offset":4161,"heading":null,"page":3,"segment_id":"S000087","start_offset":4106,"table_hint":null,"text":"In an emergency setting or hospitalized involuntarily\n\n"},{"end_offset":4281,"heading":null,"page":3,"segment_id":"S000088","start_offset":4161,"table_hint":null,"text":"Identified as a natural or adopted child of the Investigator or employee with direct involvement in the proposed study\n\n"},{"end_offset":4425,"heading":null,"page":3,"segment_id":"S000089","start_offset":4281,"table_hint":null,"text":"The above information were not intended to contain all considerations relevant to a participant's potential participation in a clinical trial.\n\n"},{"end_offset":4439,"heading":null,"page":3,"segment_id":"S000090","start_offset":4425,"table_hint":null,"text":"Trial design\n\n"},{"end_offset":4456,"heading":null,"page":3,"segment_id":"S000091","start_offset":4439,"table_hint":null,"text":"Primary purpose\n\n"},{"end_offset":4468,"heading":null,"page":3,"segment_id":"S000092","start_offset":4456,"table_hint":null,"text":"Prevention\n\n"},{"end_offset":4480,"heading":null,"page":3,"segment_id":"S000093","start_offset":4468,"table_hint":null,"text":"Allocation\n\n"},{"end_offset":4492,"heading":null,"page":3,"segment_id":"S000094","start_offset":4480,"table_hint":null,"text":"Randomized\n\n"},{"end_offset":4514,"heading":null,"page":3,"segment_id":"S000095","start_offset":4492,"table_hint":null,"text":"Interventional model\n\n"},{"end_offset":4535,"heading":null,"page":3,"segment_id":"S000096","start_offset":4514,"table_hint":null,"text":"Parallel Assignment\n\n"},{"end_offset":4544,"heading":null,"page":3,"segment_id":"S000097","st